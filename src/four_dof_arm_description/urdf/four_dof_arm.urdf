<?xml version="1.0"?>
<robot name="four_dof_industrial_arm">

  <!-- Colours used by the visible robot parts -->
  <material name="dark_grey">
    <color rgba="0.25 0.25 0.25 1"/>
  </material>

  <material name="blue">
    <color rgba="0.10 0.35 0.85 1"/>
  </material>

  <material name="orange">
    <color rgba="1.0 0.45 0.05 1"/>
  </material>

  <material name="silver">
    <color rgba="0.70 0.70 0.75 1"/>
  </material>

  <!-- Stationary base: its frame is at the bottom centre -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.12" length="0.08"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.12" length="0.08"/>
      </geometry>
    </collision>
  </link>

  <!-- Rotating pedestal -->
  <link name="rotating_base_link">
    <visual>
      <origin xyz="0 0 0.06" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.06" length="0.12"/>
      </geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.06" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.06" length="0.12"/>
      </geometry>
    </collision>
  </link>

  <!-- Joint 1: base rotation around local Z -->
  <joint name="base_rotation_joint" type="revolute">
    <parent link="base_link"/>
    <child link="rotating_base_link"/>
    <origin xyz="0 0 0.08" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14159" upper="3.14159"
           effort="30" velocity="1.0"/>
  </joint>

  <!-- Upper arm: 0.30 metres long -->
  <link name="upper_arm_link">
    <visual>
      <origin xyz="0 0 0.15" rpy="0 0 0"/>
      <geometry>
        <box size="0.06 0.06 0.30"/>
      </geometry>
      <material name="orange"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.15" rpy="0 0 0"/>
      <geometry>
        <box size="0.06 0.06 0.30"/>
      </geometry>
    </collision>
  </link>

  <!-- Joint 2: shoulder rotation around local Y -->
  <joint name="shoulder_joint" type="revolute">
    <parent link="rotating_base_link"/>
    <child link="upper_arm_link"/>
    <origin xyz="0 0 0.12" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.5708" upper="1.5708"
           effort="20" velocity="1.0"/>
  </joint>

  <!-- Forearm: 0.25 metres long -->
  <link name="forearm_link">
    <visual>
      <origin xyz="0 0 0.125" rpy="0 0 0"/>
      <geometry>
        <box size="0.05 0.05 0.25"/>
      </geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.125" rpy="0 0 0"/>
      <geometry>
        <box size="0.05 0.05 0.25"/>
      </geometry>
    </collision>
  </link>

  <!-- Joint 3: elbow rotation around local Y -->
  <joint name="elbow_joint" type="revolute">
    <parent link="upper_arm_link"/>
    <child link="forearm_link"/>
    <origin xyz="0 0 0.30" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.0944" upper="2.0944"
           effort="15" velocity="1.0"/>
  </joint>

  <!-- Wrist: 0.10 metres long -->
  <link name="wrist_link">
    <visual>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry>
        <box size="0.04 0.04 0.10"/>
      </geometry>
      <material name="orange"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry>
        <box size="0.04 0.04 0.10"/>
      </geometry>
    </collision>
  </link>

  <!-- Joint 4: wrist rotation around local Y -->
  <joint name="wrist_joint" type="revolute">
    <parent link="forearm_link"/>
    <child link="wrist_link"/>
    <origin xyz="0 0 0.25" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.5708" upper="1.5708"
           effort="5" velocity="1.5"/>
  </joint>

  <!-- Simple tool block; no movable gripper fingers -->
  <link name="tool_link">
    <visual>
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
      <geometry>
        <box size="0.08 0.04 0.06"/>
      </geometry>
      <material name="silver"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
      <geometry>
        <box size="0.08 0.04 0.06"/>
      </geometry>
    </collision>
  </link>

  <!-- Fixed attachment contributes zero DOF -->
  <joint name="tool_fixed_joint" type="fixed">
    <parent link="wrist_link"/>
    <child link="tool_link"/>
    <origin xyz="0 0 0.10" rpy="0 0 0"/>
  </joint>

</robot>

